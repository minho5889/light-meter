{
  "enabled": true,
  "name": "Non-Task Commit",
  "description": "Manually triggered hook for committing changes that are not tied to any spec task. Auto-stages all changes and commits with the non-task commit message convention [NT_{category}].",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Changes were made outside of any spec task. Do the following:\n\n1. Run `git diff` and `git status` to see what changed.\n2. Analyze the changes to determine the appropriate commit category (feat, fix, test, refactor, docs, chore, style).\n3. Stage all changes with `git add -A`.\n4. Commit using the format: `[NT_{category}]: one-liner summary` with a body containing bullet points describing what changed.\n5. Follow the commit conventions from the steering doc exactly.\n\nDo NOT ask the user for confirmation — just analyze, stage, and commit."
  }
}